NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 카카오톡·SNS 링크 미리보기용 (og:image 절대 URL)
NEXT_PUBLIC_SITE_URL=https://jeongsu-lms.vercel.app

# Server-only: student account creation, password reset (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only: AI vocabulary, listening questions, reports (never expose to client)
OPENAI_API_KEY=sk-your-openai-api-key
# Server-only: 듣기 문항 생성·AI 검수·자동 수정 (mini 사용 금지 — 상위 모델 권장)
# 미설정 시 gpt-5.5 → 실패 시 gpt-5 자동 시도
OPENAI_MODEL_LISTENING_GENERATOR=gpt-5.5
# Server-only: 학생부 분석 보고서 생성 (미설정 시 gpt-5.5 → 실패 시 gpt-5)
OPENAI_MODEL_STUDENT_RECORDS=gpt-5.5
# Server-only: 학생부 OCR (미설정 시 gpt-4o → gpt-5.5 → gpt-5, 페이지별 high detail)
OPENAI_MODEL_STUDENT_RECORDS_OCR=gpt-4o

# Server-only: 듣기학습 음원 생성 (ElevenLabs — never expose to client)
# ANN/M/W voice_id는 자동 배정. API 키만 필수.
ELEVENLABS_API_KEY=your-elevenlabs-api-key
# Optional: voice_id 직접 지정 (없으면 계정 voice 목록에서 자동 선택)
# ELEVENLABS_VOICE_ANN=
# ELEVENLABS_VOICE_M=
# ELEVENLABS_VOICE_W=
# Optional: segment mp3도 Storage에 저장 (기본 false, final.mp3만 저장)
# SAVE_TTS_SEGMENTS=true

# Client: Kakao JavaScript SDK (학습 리포트 카카오톡 공유)
NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=your-kakao-javascript-key
